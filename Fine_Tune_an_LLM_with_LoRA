        "MAX_LENGTH = 128\n",
        "\n",
        "def prepare_example(example):\n",
        "    prompt = (\n",
        "        \"### Instruction:\\n\"\n",
        "        \"Answer the customer's question politely as a \"\n",
        "        \"SmartShop customer support assistant.\\n\\n\"\n",
        "        f\"### Customer:\\n{example['question']}\\n\\n\"\n",
        "        \"### Assistant:\\n\"\n",
        "    )\n",
        "\n",
        "    prompt_ids = tokenizer(\n",
        "        prompt,\n",
        "        add_special_tokens=False\n",
        "    )[\"input_ids\"]\n",
        "\n",
        "    full_text = prompt + example[\"answer\"] + tokenizer.eos_token\n",
        "\n",
        "    full_ids = tokenizer(\n",
        "        full_text,\n",
        "        add_special_tokens=False,\n",
        "        truncation=True,\n",
        "        max_length=MAX_LENGTH\n",
        "    )[\"input_ids\"]\n",
        "\n",
        "    # Find the shared prefix to avoid masking the wrong tokens.\n",
        "    prefix_length = 0\n",
        "    for prompt_id, full_id in zip(prompt_ids, full_ids):\n",
        "        if prompt_id != full_id:\n",
        "            break\n",
        "        prefix_length += 1\n",
        "\n",
        "    # Ignore the prompt when calculating the training loss.\n",
        "    labels = (\n",
        "        [-100] * prefix_length\n",
        "        + full_ids[prefix_length:]\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"input_ids\": full_ids,\n",
        "        \"attention_mask\": [1] * len(full_ids),\n",
        "        \"labels\": labels\n",
        "    }\n",
        "\n",
        "\n",
        "prepared_examples = [\n",
        "    prepare_example(example)\n",
        "    for example in examples\n",
        "]\n",
        "\n",
        "print(\"Tokenization completed!\")\n",
        "print(\"Input tokens:\", len(prepared_examples[0][\"input_ids\"]))\n",
        "print(\"Training labels prepared:\", len(prepared_examples[0][\"labels\"]))"
